# Copy to .env and fill in. Never commit .env.
# PayPal SANDBOX only. Live credentials are never used by this project.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# AI (Gemini via Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Channel3 product catalog
CHANNEL3_API_KEY=your-channel3-api-key

# AG Grid (only needed for Enterprise features; Community needs no key)
AG_GRID_LICENSE_KEY=

# App
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./cheapest_yes.db
